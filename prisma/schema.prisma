// TokenStore database schema (PostgreSQL).
// Conventions: UUID primary keys generated by the database, snake_case tables/columns,
// timestamptz everywhere, token amounts and prices are whole integers.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum AccountType {
  PREMIUM
  OFFLINE

  @@map("account_type")
}

enum UserRole {
  PLAYER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  PENDING_LINK // registered, has not yet proven ownership of the Minecraft name in-game
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum LinkPurpose {
  LINK
  RESET

  @@map("link_purpose")
}

enum TxType {
  PLAYTIME
  PURCHASE
  REFUND
  ADMIN_GIVE
  ADMIN_TAKE
  ADMIN_SET

  @@map("tx_type")
}

enum ProductType {
  ITEM
  CRATE_KEY
  COSMETIC
  RANK
  PERMISSION
  COMMAND

  @@map("product_type")
}

enum PurchaseSource {
  WEB
  GAME

  @@map("purchase_source")
}

enum PurchaseStatus {
  PENDING_DELIVERY
  DELIVERED
  NEEDS_REVIEW // delivery outcome uncertain; an admin must decide (retry or cancel + refund)
  FAILED
  CANCELLED

  @@map("purchase_status")
}

enum RewardStatus {
  PENDING
  CLAIMED
  DELIVERED
  FAILED
  NEEDS_REVIEW
  CANCELLED

  @@map("reward_status")
}

// ───────────────────────────── Accounts ─────────────────────────────

model User {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName            String      @map("display_name") @db.VarChar(32)
  minecraftUsername      String      @map("minecraft_username") @db.VarChar(16)
  minecraftUsernameLower String      @unique @map("minecraft_username_lower") @db.VarChar(16)
  accountType            AccountType @map("account_type")
  passwordHash           String      @map("password_hash")
  role                   UserRole    @default(PLAYER)
  status                 UserStatus  @default(PENDING_LINK)
  // Unlinked registrations release their username claim after this moment.
  linkDeadline           DateTime?   @map("link_deadline") @db.Timestamptz(3)
  failedLoginCount       Int         @default(0) @map("failed_login_count")
  lockedUntil            DateTime?   @map("locked_until") @db.Timestamptz(3)
  lastLoginAt            DateTime?   @map("last_login_at") @db.Timestamptz(3)
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  minecraftAccount MinecraftAccount?
  sessions         Session[]
  linkCodes        LinkCode[]
  purchases        Purchase[]
  auditLogs        AdminAuditLog[]

  @@map("users")
}

model MinecraftAccount {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mcUuid               String       @unique @map("mc_uuid") @db.Uuid
  username             String       @db.VarChar(16)
  userId               String?      @unique @map("user_id") @db.Uuid
  accountType          AccountType? @map("account_type")
  // True when the linking server ran in online mode, i.e. Mojang authenticated the UUID.
  onlineModeVerified   Boolean      @default(false) @map("online_mode_verified")
  linkedAt             DateTime?    @map("linked_at") @db.Timestamptz(3)
  playtimeTotalSeconds Int          @default(0) @map("playtime_total_seconds")
  // Eligible seconds not yet converted into a whole token.
  playtimeCarrySeconds Int          @default(0) @map("playtime_carry_seconds")
  firstSeenAt          DateTime     @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt           DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  balance         TokenBalance?
  transactions    TokenTransaction[]
  purchases       Purchase[]
  rewards         RewardQueue[]
  playtimeRecords PlaytimeRecord[]

  @@index([username])
  @@map("minecraft_accounts")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  // SHA-256 of the random session token; the raw token only lives in the cookie.
  tokenHash  String    @unique @map("token_hash")
  // SHA-256 of the per-session CSRF secret.
  csrfHash   String    @map("csrf_hash")
  ip         String?   @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// One-time codes typed in-game as `/rconfirmT <code>`: account linking and password reset.
model LinkCode {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  purpose    LinkPurpose
  // SHA-256 of the code; the plaintext is shown to the user once and never stored.
  codeHash   String      @unique @map("code_hash")
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?   @map("consumed_at") @db.Timestamptz(3)
  attempts   Int         @default(0)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("link_codes")
}

// ───────────────────────────── Tokens ─────────────────────────────

model TokenBalance {
  mcAccountId String   @id @map("mc_account_id") @db.Uuid
  balance     Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  account MinecraftAccount @relation(fields: [mcAccountId], references: [id], onDelete: Cascade)

  @@map("token_balances")
}

model TokenTransaction {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mcAccountId    String   @map("mc_account_id") @db.Uuid
  // Signed: positive credits, negative debits.
  amount         Int
  balanceAfter   Int      @map("balance_after")
  type           TxType
  reason         String?  @db.VarChar(255)
  // Unique across all transactions: the same logical operation can never apply twice.
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(128)
  purchaseId     String?  @map("purchase_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorLabel     String?  @map("actor_label") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account  MinecraftAccount @relation(fields: [mcAccountId], references: [id], onDelete: Cascade)
  purchase Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([mcAccountId, createdAt(sort: Desc)])
  @@index([purchaseId])
  @@map("token_transactions")
}

model PlaytimeRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mcAccountId     String   @map("mc_account_id") @db.Uuid
  serverId        String?  @map("server_id") @db.Uuid
  idempotencyKey  String   @unique @map("idempotency_key") @db.VarChar(128)
  eligibleSeconds Int      @map("eligible_seconds")
  afkSeconds      Int      @default(0) @map("afk_seconds")
  periodStart     DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd       DateTime @map("period_end") @db.Timestamptz(3)
  rateSeconds     Int      @map("rate_seconds")
  tokensAwarded   Int      @default(0) @map("tokens_awarded")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account MinecraftAccount @relation(fields: [mcAccountId], references: [id], onDelete: Cascade)
  server  ServerInstance?  @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([mcAccountId, createdAt(sort: Desc)])
  @@map("playtime_records")
}

// ───────────────────────────── Shop ─────────────────────────────

model Category {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique @db.VarChar(64)
  name         String   @db.VarChar(64)
  description  String?  @db.VarChar(255)
  iconMaterial String   @default("CHEST") @map("icon_material") @db.VarChar(64)
  sortOrder    Int      @default(0) @map("sort_order")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

model Product {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String      @map("category_id") @db.Uuid
  slug           String      @unique @db.VarChar(64)
  name           String      @db.VarChar(64)
  description    String      @default("") @db.VarChar(2000)
  imageUrl       String?     @map("image_url") @db.VarChar(512)
  price          Int
  type           ProductType
  // In-game GUI presentation.
  iconMaterial   String      @default("PAPER") @map("icon_material") @db.VarChar(64)
  lore           String[]
  // Console commands run on delivery. Placeholders: {player} {uuid}.
  // Only ever written by admins; the browser can never supply these.
  commands       String[]
  enabled        Boolean     @default(true)
  stockLimit     Int?        @map("stock_limit")
  stockSold      Int         @default(0) @map("stock_sold")
  perPlayerLimit Int?        @map("per_player_limit")
  sortOrder      Int         @default(0) @map("sort_order")
  // Soft delete keeps purchase history intact.
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purchases Purchase[]

  @@index([categoryId, sortOrder])
  @@map("products")
}

model Purchase {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mcAccountId    String         @map("mc_account_id") @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  productId      String?        @map("product_id") @db.Uuid
  // Snapshot at purchase time: later edits to the product never change what was bought.
  productName    String         @map("product_name") @db.VarChar(64)
  unitPrice      Int            @map("unit_price")
  source         PurchaseSource
  status         PurchaseStatus @default(PENDING_DELIVERY)
  idempotencyKey String         @unique @map("idempotency_key") @db.VarChar(128)
  failureReason  String?        @map("failure_reason") @db.VarChar(255)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(3)
  cancelledAt    DateTime?      @map("cancelled_at") @db.Timestamptz(3)

  account      MinecraftAccount   @relation(fields: [mcAccountId], references: [id], onDelete: Restrict)
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  product      Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  reward       RewardQueue?
  transactions TokenTransaction[]

  @@index([mcAccountId, createdAt(sort: Desc)])
  @@index([status])
  @@map("purchases")
}

model RewardQueue {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId        String       @unique @map("purchase_id") @db.Uuid
  mcAccountId       String       @map("mc_account_id") @db.Uuid
  // Commands copied from the product at purchase time.
  commands          String[]
  status            RewardStatus @default(PENDING)
  attempts          Int          @default(0)
  // Number of commands already executed; a retry resumes after this index.
  commandsCompleted Int          @default(0) @map("commands_completed")
  claimedByServerId String?      @map("claimed_by_server_id") @db.Uuid
  claimedAt         DateTime?    @map("claimed_at") @db.Timestamptz(3)
  leaseExpiresAt    DateTime?    @map("lease_expires_at") @db.Timestamptz(3)
  deliveredAt       DateTime?    @map("delivered_at") @db.Timestamptz(3)
  lastError         String?      @map("last_error") @db.VarChar(255)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchase Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  account  MinecraftAccount @relation(fields: [mcAccountId], references: [id], onDelete: Cascade)
  server   ServerInstance?  @relation(fields: [claimedByServerId], references: [id], onDelete: SetNull)

  @@index([status, mcAccountId])
  @@map("reward_queue")
}

// ───────────────────────────── Server link & ops ─────────────────────────────

model ServerInstance {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Identifier configured in the plugin's config.yml (e.g. "main").
  name          String    @unique @db.VarChar(64)
  pluginVersion String?   @map("plugin_version") @db.VarChar(32)
  serverVersion String?   @map("server_version") @db.VarChar(64)
  onlineMode    Boolean?  @map("online_mode")
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(3)
  lastIp        String?   @map("last_ip") @db.VarChar(64)
  lastError     String?   @map("last_error") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  playtimeRecords PlaytimeRecord[]
  rewards         RewardQueue[]

  @@map("server_instances")
}

// Replay protection for signed server requests.
model ServerNonce {
  nonceHash String   @id @map("nonce_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("server_nonces")
}

model AdminAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorLabel  String?  @map("actor_label") @db.VarChar(64)
  action      String   @db.VarChar(64)
  targetType  String?  @map("target_type") @db.VarChar(32)
  targetId    String?  @map("target_id") @db.VarChar(64)
  ip          String?  @db.VarChar(64)
  requestId   String?  @map("request_id") @db.VarChar(64)
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@map("admin_audit_logs")
}

model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(255)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

// Fixed-window rate limiting shared by every web instance.
model RateLimitBucket {
  key         String   @db.VarChar(160)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}
